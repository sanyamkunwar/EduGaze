# -----------------------------
# Python / FastAPI / Streamlit
# -----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pkl
*.pickle

# -----------------------------
# Virtual Environments
# -----------------------------
venv/
.env/
.env.bak/
*.env

# -----------------------------
# OS / System Files
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# Logs & Temp Files
# -----------------------------
logs/
*.log
*.csv
*.tmp
*.swp
*.swo

# -----------------------------
# Model Files (Too Large)
# -----------------------------
models/*.h5
models/*.tflite
models/*.pt
models/*.onnx
models/training/
models/fer2013.zip

# Keep only code-based files inside "models/"
!models/.gitkeep

# -----------------------------
# Data & Training Images
# -----------------------------
data/
datasets/
train/
test/
*.zip
*.tar.gz

# -----------------------------
# Webcam Frames / Uploads
# -----------------------------
frames/
uploads/
temp_images/

# -----------------------------
# Node / JS (Streamlit sometimes creates temp builds)
# -----------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------
# IDE Project Settings
# -----------------------------
.vscode/
.idea/
*.iml

# -----------------------------
# Build / Deploy Artifacts
# -----------------------------
build/
dist/
*.spec
*.egg-info/

# -----------------------------
# Jupyter Notebooks
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# Streamlit Cache
# -----------------------------
.streamlit/
